# Copy this file to .streamlit/secrets.toml for local cloud-database testing.
# NEVER commit the real secrets.toml file to GitHub.

DATABASE_URL = "postgresql://YOUR_SUPABASE_CONNECTION_STRING"
JOURNAL_TRADER_USER = "your_username"
JOURNAL_TRADER_PASS = "choose-a-strong-password"
JOURNAL_MENTOR_TOKEN = "paste-a-long-random-secret-token-here"
